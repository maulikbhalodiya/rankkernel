 /**
- * Dashboard card layout.
+ * Dashboard layout.
  *
- * Loaded only on the RankKernel dashboard. Every rule is scoped under
- * .rk-dashboard. All colour, spacing, type, radius and shadow values come
- * from the --rk-* tokens in the shared token layer, which loads as a
- * registered dependency before this sheet.
+ * Loaded only on the RankKernel dashboard. The card surface, header, pills and
+ * buttons all come from the shared component layer in rankkernel-ui.css. This
+ * sheet only owns what is genuinely page specific: the card grid and the
+ * internals of one module card. No raw hex appears here, every value resolves
+ * from the --rk-* tokens in rankkernel-admin.css, which loads first as a
+ * registered dependency.
  */
 
-.rk-cards {
+/* The card grid needs no narrow width override. The auto-fill track already
+   collapses to one column as soon as two 280 pixel tracks no longer fit, and
+   it clamps to the container when even one does not fit, so this grid is a
+   single column at every width below about 576 pixels. The card actions row
+   below already wraps at any width, and the page header stacks itself in the
+   shared layer at 782 pixels, so there was no work left for a page media
+   query to do. */
+.rk-dashboard .rk-cards {
 	display: grid;
 	grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
 	gap: var(--rk-space-4);
-	margin-block-start: var(--rk-space-5);
+	margin-block-start: var(--rk-space-4);
 }
 
-.rk-card {
+/* One module card. The surface, border, radius and shadow are already set by
+.rk-ui-card, so this only stacks the contents and owns the inner padding. No
+overflow clipping is set here, because a clip would cut the focus ring painted
+outside the card edge on the Settings link and the toggle button. Nothing in
+this card overflows its own box, so the clip bought nothing. */
+.rk-dashboard .rk-card {
 	display: flex;
 	flex-direction: column;
-	padding: var(--rk-space-4);
-	border: 1px solid var(--rk-color-border);
-	border-radius: var(--rk-radius-lg);
-	background: var(--rk-color-surface);
-	box-shadow: var(--rk-shadow-sm);
-}
-
-.rk-card.is-enabled {
-	border-block-start: 3px solid var(--rk-color-primary);
+	padding: 0;
 }
 
-.rk-card-head {
-	display: flex;
-	align-items: baseline;
-	justify-content: space-between;
-	gap: var(--rk-space-2);
+/* Inside a grid card the shared card header drops its divider, so the card
+reads as one block rather than a divided panel. */
+.rk-dashboard .rk-card .rk-ui-card-header {
+	padding: var(--rk-space-4);
+	border-block-end: 0;
 }
 
-.rk-card-title {
-	margin: 0;
+.rk-dashboard .rk-card .rk-ui-card-title {
 	font-size: var(--rk-font-size-lg);
-	line-height: var(--rk-line-height-tight);
-}
-
-.rk-card-state {
-	color: var(--rk-color-text-muted);
-	font-size: var(--rk-font-size-xs);
-	text-transform: uppercase;
-	letter-spacing: 0.04em;
 }
 
-.rk-card.is-enabled .rk-card-state {
-	color: var(--rk-color-secondary-1);
-}
-
-.rk-card-desc {
+.rk-dashboard .rk-card-desc {
 	flex: 1 1 auto;
-	margin: var(--rk-space-2) 0 var(--rk-space-4);
+	margin: var(--rk-space-2) var(--rk-space-4) var(--rk-space-4);
 	color: var(--rk-color-text-secondary);
 	font-size: var(--rk-font-size-sm);
 	line-height: var(--rk-line-height-normal);
 }
 
-.rk-card-actions {
+.rk-dashboard .rk-card-actions {
 	display: flex;
 	align-items: center;
+	flex-wrap: wrap;
 	gap: var(--rk-space-2);
+	padding: 0 var(--rk-space-4) var(--rk-space-4);
+
+	/* A card carrying no description still keeps its actions on the baseline. */
+	margin-block-start: auto;
 }
 
-.rk-card-toggle {
+.rk-dashboard .rk-card-toggle {
 	margin: 0;
 }
 
