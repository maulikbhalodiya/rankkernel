{
    "name": "rankkernel/rankkernel",
    "description": "The Free, Zero-Bloat Open-Source SEO Engine for WordPress",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Maulik Bhalodiya",
            "homepage": "https://github.com/maulikbhalodiya"
        }
    ],
    "require": {
        "php": ">=8.2"
    },
    "autoload": {
        "psr-4": {
            "RankKernel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RankKernel\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.10",
        "wp-coding-standards/wpcs": "^3.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpstan/phpstan": "^1.12",
        "szepeviktor/phpstan-wordpress": "^1.3",
        "phpunit/phpunit": "^10.5",
        "brain/monkey": "^2.6",
        "yoast/phpunit-polyfills": "^2.0"
    },
    "scripts": {
        "lint": "phpcs --standard=phpcs.xml",
        "phpcs": "phpcs --standard=phpcs.xml",
        "phpcbf": "phpcbf --standard=phpcs.xml",
        "stan": "phpstan analyse --level=6 src/",
        "test": "phpunit",
        "test:js": "node --test tests/js/*.test.js"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "yoast/phpunit-polyfills": true
        }
    }
}
