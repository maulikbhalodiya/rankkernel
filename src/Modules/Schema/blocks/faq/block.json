{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "rankkernel/faq",
  "title": "FAQ by RankKernel",
  "description": "Add SEO friendly frequently asked questions with automatic FAQPage schema.",
  "category": "rankkernel",
  "icon": "editor-ul",
  "textdomain": "rankkernel",
  "keywords": [ "FAQ", "Frequently Asked Questions", "Schema", "Structured Data" ],
  "editorScript": "file:./faq-editor.js",
  "attributes": {
    "title": {
      "type": "string",
      "default": ""
    },
    "titleWrapper": {
      "type": "string",
      "default": "h3"
    },
    "listStyle": {
      "type": "string",
      "default": "ul",
      "enum": [ "ul", "ol" ]
    },
    "questions": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string"
          },
          "answer": {
            "type": "string"
          }
        }
      }
    }
  }
}
