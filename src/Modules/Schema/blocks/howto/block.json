{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "rankkernel/howto",
  "title": "HowTo by RankKernel",
  "description": "Add SEO friendly how-to steps with automatic HowTo schema.",
  "category": "rankkernel",
  "icon": "editor-ol",
  "textdomain": "rankkernel",
  "keywords": [ "HowTo", "How To", "Steps", "Schema", "Structured Data" ],
  "attributes": {
    "title": {
      "type": "string",
      "default": ""
    },
    "titleWrapper": {
      "type": "string",
      "default": "h3"
    },
    "steps": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "image": {
            "type": "string"
          }
        }
      }
    }
  }
}
