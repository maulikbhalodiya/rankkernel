<?xml version="1.0"?>
<ruleset name="RankKernel">
    <description>RankKernel strict WordPress.org standard formatting and security ruleset.</description>

    <!-- Set the minimum PHP version RankKernel is being checked against. -->
    <config name="testVersion" value="8.1-"/>
    <config name="minimum_supported_wp_version" value="6.5"/>
    <config name="text_domain" value="rankkernel"/>

    <!-- Set files and paths to scan -->
    <file>.</file>
    <arg name="extensions" value="php"/>

    <!-- Ignore third-party dependencies and build files -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/build/*</exclude-pattern>
    <exclude-pattern>tests/bootstrap.php</exclude-pattern>

    <!-- Enforce the complete standard suite for WordPress core formatting and security -->
    <rule ref="WordPress"/>

    <!--
        Project naming decision, preserved deliberately. RankKernel keeps PSR-4
        file names, camelCase methods and variables, and short array syntax as an
        approved architecture decision, so the Composer PSR-4 autoloader and the
        existing internal API stay intact. These four sniffs are the only ones
        turned off, they are scoped to src and tests, and every other WordPress
        sniff remains enforced. Converting to WordPress file and symbol naming is
        planned as its own phase with the matching autoloader change.
    -->
    <rule ref="WordPress.Files.FileName">
        <exclude-pattern>src/.*</exclude-pattern>
        <exclude-pattern>tests/.*</exclude-pattern>
    </rule>
    <rule ref="WordPress.NamingConventions.ValidVariableName">
        <exclude-pattern>src/.*</exclude-pattern>
        <exclude-pattern>tests/.*</exclude-pattern>
    </rule>
    <rule ref="WordPress.NamingConventions.ValidFunctionName.MethodNameInvalid">
        <exclude-pattern>src/.*</exclude-pattern>
        <exclude-pattern>tests/.*</exclude-pattern>
    </rule>
    <rule ref="Universal.Arrays.DisallowShortArraySyntax">
        <exclude-pattern>src/.*</exclude-pattern>
        <exclude-pattern>tests/.*</exclude-pattern>
    </rule>
</ruleset>
